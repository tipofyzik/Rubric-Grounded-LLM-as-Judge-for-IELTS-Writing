# По умолчанию отслеживать только перечисленные файлы и код.
*
# !.gitignore
!README.md
!requirements.txt
# !requirements-dev.txt
# !pyrightconfig.json
# !kaggle/
# !kaggle/**
# kaggle/artifacts/
# kaggle/.cache/
# kaggle/.venv/
# kaggle/**/__pycache__/
!code/
!code/**

# Локальное окружение и кеши Python.
code/.venv/
code/.env
code/**/__pycache__/
code/.pytest_cache/
code/.ruff_cache/
code/*.egg-info/

# Файлы инициализации пакетов.
code/**/__init__.py

# Локальные данные, модели и результаты экспериментов.
code/resources/datasets/
code/resources/LLM evaluation/
code/resources/AES models/
code/resources/AES predictions/
code/resources/panda insights/

# Локальная заметка о рефакторинге.
code/**/LLMEvaluatorRefactoringReview.md
code/docs
code/stage0_space
code/stage1_space
code/tests
code/tools
code/dataset
code/docs
code/resources/panda_comparison.json

